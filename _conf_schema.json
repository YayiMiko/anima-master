      "sensual_mode_markers": {
        "description": "涩气触发词",
        "type": "list",
        "default": [
          "色气",
          "涩气",
          "擦边",
          "边界感",
          "性感",
          "诱惑",
          "魅惑",
          "妖艳",
          "撩人",
          "暧昧",
          "挑逗",
          "诱人",
          "透明",
          "透视",
          "黑纱",
          "薄纱",
          "蕾丝",
          "吊带",
          "紧身",
          "露肩",
          "绝对领域",
          "小恶魔",
          "suggestive",
          "seductive",
          "sexy",
          "sensual",
          "alluring",
          "see-through",
          "sheer",
          "transparent",
          "lace",
          "garter",
          "teasing"
        ],
        "items": {
          "type": "string"
        },
        "hint": "示例：涩气, 透明, lace, teasing",
        "collapsed": true,
        "condition": {
