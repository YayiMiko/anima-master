{
  "anima_master_basic": {
    "description": "预设与恢复",
    "type": "object",
    "hint": "用于恢复默认配置，或快速应用千代预设。",
    "items": {
      "reset_to_defaults": {
        "description": "一键恢复默认配置",
        "type": "bool",
        "default": false,
        "hint": "打开后保存配置并重载插件，即会恢复默认值；恢复后此开关会自动关闭。"
      },
      "chiyo_preset": {
        "description": "千代预设",
        "type": "string",
        "default": "",
        "options": [
          "",
          "base",
          "aesthetic",
          "turbo"
        ],
        "labels": [
          "未启用",
          "千代base",
          "千代aesthetic",
          "千代turbo"
        ],
        "hint": "选择后补入对应的千代画师组，并把“狐莉”加入角色列表；狐莉只会在明确提到时使用。千代base 使用 anima_baseV10 与 CFG 5；千代aesthetic 使用 anima_aestheticV11、CFG 3，且不加质量词和负面词；千代turbo 使用 Turbo LoRA 工作流、10 步、CFG 1、euler/simple，并启用低 CFG 提示词约束。保存并重载插件后，模型、参数和提示词字段会同步显示预设值；选择“未启用”可恢复启用前的值。"
      }
    }
  },
  "anima_master_comfyui_connection": {
    "description": "ComfyUI 连接",
    "type": "object",
    "hint": "用于连接 ComfyUI。通常请先用绘世启动器、ComfyUI portable 或自己的方式启动 ComfyUI；AstrBot 在服务器时请填写本机的局域网或 Tailscale 地址。只有 AstrBot 和 ComfyUI 同机时，才建议开启“由 AstrBot 启动 ComfyUI”。",
    "items": {
      "comfyui_base_url": {
        "description": "ComfyUI 地址",
        "type": "string",
        "default": "http://127.0.0.1:8188",
        "hint": "填写 AstrBot 能访问到的 ComfyUI API 服务地址，不是绘世启动器页面。同机通常用 http://127.0.0.1:8188；AstrBot 在服务器、ComfyUI 在本机时，请填写本机的局域网或 Tailscale 地址。"
      },
      "workflow": {
        "description": "插件工作流类型",
        "type": "string",
        "default": "anima_t2i",
        "hint": "这是插件内置的工作流类型，不是 ComfyUI 里保存的工作流名称。当前保持默认即可。示例：anima_t2i",
        "collapsed": true,
        "condition": {
          "custom_workflow_enabled": false
        }
      },
      "custom_workflow_enabled": {
        "description": "使用自定义 ComfyUI 工作流",
        "type": "bool",
        "default": false,
        "hint": "开启后使用下方填写的 ComfyUI API 工作流 JSON。关闭后使用插件内置工作流。"
      },
      "custom_workflow_path": {
        "description": "自定义工作流 JSON 路径",
        "type": "string",
        "default": "",
        "hint": "填写 AstrBot 能读取到的 ComfyUI API 工作流 JSON 路径。服务器部署时这是服务器路径，不是本机 Windows 路径；也可以填写相对插件目录的路径。留空时不启用。示例：workflows/anima_api.json",
        "collapsed": false,
        "condition": {
          "custom_workflow_enabled": true
        }
      },
      "custom_workflow_override_parameters": {
        "description": "用插件参数覆盖自定义工作流参数",
        "type": "bool",
        "default": false,
        "hint": "默认关闭，保留自定义工作流中的尺寸、采样步数、CFG、采样器和调度器。开启后才使用插件出图参数覆盖这些节点。",
        "condition": {
          "custom_workflow_enabled": true
        }
      },
      "timeout": {
        "description": "单次生成超时（秒）",
        "type": "int",
        "default": 300,
        "hint": "示例：300",
        "collapsed": true
      },
      "storage_retention_days": {
        "description": "输入、输出和任务记录保留天数",
        "type": "int",
        "default": 30,
        "hint": "设为 0 可关闭按时间清理；默认 30 天。",
        "collapsed": true
      },
      "manifest_max_records": {
        "description": "输入图片清单最大记录数",
        "type": "int",
        "default": 5000,
        "hint": "清理时只保留仍存在的最近记录。",
        "collapsed": true
      },
      "poll_interval": {
        "description": "生成状态查询间隔（秒）",
        "type": "int",
        "default": 2,
        "hint": "示例：2",
        "collapsed": true
      },
      "auto_start": {
        "description": "由 AstrBot 启动 ComfyUI",
        "type": "bool",
        "default": false,
        "hint": "高级选项，仅适合 AstrBot 和 ComfyUI 在同一台机器上时使用。服务器 AstrBot 无法直接启动你本机 Windows 上的 ComfyUI。默认关闭；关闭时请用绘世启动器、ComfyUI portable 或自己的方式先启动 ComfyUI。不是开机自启。",
        "collapsed": true
      },
      "startup_command": {
        "description": "启动命令（开启上项后必填）",
        "type": "string",
        "default": "",
        "hint": "仅在开启“由 AstrBot 启动 ComfyUI”后必填。命令会在 AstrBot 所在机器执行；如果 AstrBot 跑在服务器容器里，这里不能填写本机 Windows 路径。",
        "condition": {
          "auto_start": true
        }
      },
      "startup_workdir": {
        "description": "启动工作目录",
        "type": "string",
        "default": "",
        "hint": "示例：D:\\ComfyUI",
        "collapsed": true,
        "condition": {
          "auto_start": true
        }
      },
      "startup_visible_window": {
        "description": "启动时显示窗口",
        "type": "bool",
        "default": true,
        "collapsed": true,
        "condition": {
          "auto_start": true
        }
      },
      "auto_start_admin_only": {
        "description": "仅管理员可启动 ComfyUI",
        "type": "bool",
        "default": true,
        "collapsed": true,
        "condition": {
          "auto_start": true
        }
      },
      "auto_start_allowed_sender_ids": {
        "description": "允许启动的用户",
        "type": "list",
        "default": [],
        "collapsed": true,
        "condition": {
          "auto_start": true
        },
        "items": {
          "type": "string"
        },
        "hint": "填写 QQ 号或 AstrBot 识别到的 sender_id；留空表示不限制。示例：123456789"
      },
      "startup_wait_seconds": {
        "description": "等待 ComfyUI 就绪时间（秒）",
        "type": "int",
        "default": 120,
        "hint": "示例：120",
        "collapsed": true,
        "condition": {
          "auto_start": true
        }
      },
      "startup_poll_interval": {
        "description": "ComfyUI 就绪检查间隔（秒）",
        "type": "int",
        "default": 3,
        "hint": "示例：3",
        "collapsed": true,
        "condition": {
          "auto_start": true
        }
      }
    }
  },
  "anima_master_models": {
    "description": "模型文件",
    "type": "object",
    "hint": "首次配置时请对照 ComfyUI 下拉框确认；这里只填文件名，不填路径。如果状态检查显示模型不可用，优先检查这里。",
    "items": {
      "unet_name": {
        "description": "主模型文件名",
        "type": "string",
        "default": "anima_baseV10.safetensors",
        "hint": "首次配置时请确认它与 ComfyUI 下拉框中的文件名一致，不要填路径。示例：anima_baseV10.safetensors"
      },
      "clip_name": {
        "description": "文本编码器文件名",
        "type": "string",
        "default": "qwen_3_06b_base.safetensors",
        "hint": "首次配置时请确认它与 ComfyUI 下拉框中的文件名一致，不要填路径。示例：qwen_3_06b_base.safetensors"
      },
      "vae_name": {
        "description": "VAE 文件名",
        "type": "string",
        "default": "qwen_image_vae.safetensors",
        "hint": "首次配置时请确认它与 ComfyUI 下拉框中的文件名一致，不要填路径。示例：qwen_image_vae.safetensors"
      }
    },
    "condition": {
      "anima_master_comfyui_connection.custom_workflow_enabled": false
    }
  },
  "anima_master_rendering": {
    "description": "出图参数",
    "type": "object",
    "hint": "控制默认尺寸、采样步数、CFG、采样器和调度器。",
    "items": {
      "width": {
        "description": "默认宽度",
        "type": "int",
        "default": 1024,
        "hint": "默认推荐 1024 x 1536；如果填写了不支持的尺寸，插件会自动贴近到可用尺寸。示例：1024"
      },
      "height": {
        "description": "默认高度",
        "type": "int",
        "default": 1536,
        "hint": "默认推荐 1024 x 1536；如果填写了不支持的尺寸，插件会自动贴近到可用尺寸。示例：1536"
      },
      "allowed_sizes": {
        "description": "可用尺寸列表",
        "type": "list",
        "default": [
          "832x1216",
          "896x1152",
          "1024x1024",
          "1152x896",
          "1216x832",
          "768x1344",
          "1344x768",
          "1024x1536"
        ],
        "hint": "格式为 宽x高，例如 1024x1536。默认尺寸不在列表中时，会自动使用最接近的允许尺寸。",
        "collapsed": true,
        "items": {
          "type": "string"
        }
      },
      "steps": {
        "description": "采样步数",
        "type": "int",
        "default": 30,
        "hint": "示例：30",
        "collapsed": true
      },
      "cfg": {
        "description": "CFG 强度",
        "type": "float",
        "default": 5,
        "hint": "示例：5.0",
        "collapsed": true
      },
      "sampler_name": {
        "description": "采样器",
        "type": "string",
        "default": "er_sde",
        "hint": "示例：er_sde"
      },
      "scheduler": {
        "description": "调度器",
        "type": "string",
        "default": "normal",
        "hint": "示例：normal"
      }
    },
    "condition": {
      "anima_master_comfyui_connection.custom_workflow_enabled": false
    }
  },
  "anima_master_default_prompt": {
    "description": "默认提示词",
    "type": "object",
    "hint": "控制每次生图都会自动加入的正面质量词和负面提示词。",
    "items": {
      "quality_prefix": {
        "description": "质量词前缀",
        "type": "string",
        "default": "masterpiece, best quality, score_7, safe,",
        "hint": "每次生图都会自动加在正面提示词前面。示例：masterpiece, best quality, score_7, safe,"
      },
      "negative_prompt": {
        "description": "负面提示词",
        "type": "string",
        "default": "worst quality, low quality, score_1, score_2, score_3, artist name",
        "hint": "每次生图都会作为反向提示词使用。示例：worst quality, low quality, score_1, score_2, score_3, artist name"
      }
    }
  },
  "anima_master_prompting": {
    "description": "自然语言优化",
    "type": "object",
    "hint": "控制中文描述转 Danbooru tags 的方式，以及是否启用联网搜索与深度思考。",
    "items": {
      "prompt_optimize_enabled": {
        "description": "启用自然语言优化",
        "type": "bool",
        "default": true,
        "hint": "开启后会把中文描述扩展成适合生图的 tags；关闭后更接近原样提交。"
      },
      "prompt_builder_provider_id": {
        "description": "自然语言优化模型",
        "type": "string",
        "default": "",
        "hint": "留空使用当前会话主模型。只有想单独指定提示词优化模型时再填写。",
        "collapsed": true,
        "condition": {
          "prompt_optimize_enabled": true
        }
      },
      "prompt_builder_max_tokens": {
        "description": "优化模型输出上限",
        "type": "int",
        "default": 1000,
        "hint": "示例：1000",
        "collapsed": true,
        "condition": {
          "prompt_optimize_enabled": true
        }
      },
      "prompt_builder_max_content_tags": {
        "description": "内容 Tag 数量上限",
        "type": "int",
        "default": 65,
        "hint": "只限制 LLM 生成的内容段，不计质量词、固定角色、画师组和画风。常规目标为 40-55，复杂画面约 60，建议保持硬上限 65。",
        "collapsed": true,
        "condition": {
          "prompt_optimize_enabled": true
        }
      },
      "prompt_builder_web_search_enabled": {
        "description": "关键词触发联网搜索",
        "type": "bool",
        "default": true,
        "hint": "只在指令里明确写“联网搜索”时使用；需要在 AstrBot 的联网搜索 / 提供商设置中配置 Tavily Key，否则不会成功搜索。",
        "collapsed": true,
        "condition": {
          "prompt_optimize_enabled": true
        }
      },
      "prompt_builder_search_max_results": {
        "description": "搜索结果数量",
        "type": "int",
        "default": 5,
        "hint": "示例：5",
        "collapsed": true,
        "condition": {
          "prompt_optimize_enabled": true,
          "prompt_builder_web_search_enabled": true
        }
      },
      "prompt_builder_search_depth": {
        "description": "搜索深度",
        "type": "string",
        "default": "advanced",
        "hint": "可选：basic / advanced。 示例：advanced",
        "collapsed": true,
        "condition": {
          "prompt_optimize_enabled": true,
          "prompt_builder_web_search_enabled": true
        }
      },
      "prompt_builder_search_query_template": {
        "description": "搜索词模板",
        "type": "string",
        "default": "{prompt} 角色 外观 立绘 服装 配色 武器 官方图 official art character design outfit appearance wiki fandom",
        "hint": "普通用户不需要修改；只有想改变联网搜索关键词组成时再改。{prompt} 会代表用户原始需求。",
        "collapsed": true,
        "condition": {
          "prompt_optimize_enabled": true,
          "prompt_builder_web_search_enabled": true
        }
      },
      "prompt_builder_deep_thinking_enabled": {
        "description": "关键词触发深度思考",
        "type": "bool",
        "default": true,
        "hint": "只在指令里明确写“深度思考”时尝试启用；不支持会自动降级。",
        "collapsed": true,
        "condition": {
          "prompt_optimize_enabled": true
        }
      },
      "prompt_builder_reasoning_effort": {
        "description": "思考强度",
        "type": "string",
        "default": "high",
        "hint": "常用：high / max。 示例：high",
        "collapsed": true,
        "condition": {
          "prompt_optimize_enabled": true,
          "prompt_builder_deep_thinking_enabled": true
        }
      },
      "prompt_builder_template": {
        "description": "自然语言优化模板",
        "type": "string",
        "default": "\u6211\u662f\u4e00\u540d AI \u753b\u5e08\uff0c\u8bf7\u6839\u636e\u4ee5\u4e0b\u4e3b\u9898\u8bbe\u8ba1\u5927\u5e08\u7ea7\u63d0\u793a\u8bcd\u3002\u8f93\u51fa\u5e94\u4e3a\u9002\u7528\u4e8e Anima \u6a21\u578b\u7684\u82f1\u6587 Danbooru tags\uff0c\u800c\u4e0d\u662f\u81ea\u7136\u8bed\u8a00\u63cf\u8ff0\u3002\n\n\u8bf7\u5148\u5728\u5185\u90e8\u62c6\u89e3\u753b\u9762\uff0c\u518d\u5c06\u7ed3\u679c\u6c47\u603b\u4e3a\u4e00\u884c\u3001\u4f7f\u7528\u82f1\u6587\u9017\u53f7\u5206\u9694\u7684 tags\u3002\u4e0d\u8981\u8f93\u51fa\u5206\u6790\u8fc7\u7a0b\u3001\u6807\u9898\u3001Markdown\u3001\u7f16\u53f7\u6216\u4e2d\u6587\u3002\n\n\u5185\u5bb9\u89c4\u5219\uff1a\n- \u4e3a\u753b\u9762\u8bbe\u8ba1\u7ec6\u81f4\u7684\u670d\u9970 tags\u3001\u52a8\u4f5c tags\u3001\u795e\u6001 tags\uff0c\u5e76\u6839\u636e\u4e3b\u9898\u8865\u5145\u5fc5\u8981\u7684\u73af\u5883\u3001\u80cc\u666f\u3001\u6c1b\u56f4\u3001\u6784\u56fe\u3001\u955c\u5934\u3001\u5149\u5f71\u548c\u7279\u6548 tags\u3002\n- \u4e0d\u8981\u8f93\u51fa\u89d2\u8272\u81ea\u8eab\u5df2\u6709\u7684\u56fa\u5b9a\u8bbe\u5b9a\uff0c\u4f8b\u5982\u53d1\u8272\u3001\u77b3\u8272\u3001\u5e74\u9f84\u3001\u79cd\u65cf\u548c\u56fa\u5b9a\u914d\u9970\uff1b\u56fa\u5b9a\u89d2\u8272\u8bcd\u4f1a\u7531\u7a0b\u5e8f\u53e6\u884c\u62fc\u63a5\u3002\n- \u4e0d\u8981\u8f93\u51fa masterpiece\u3001best quality \u7b49\u524d\u7f6e\u8d28\u91cf\u8bcd\uff0c\u4e5f\u4e0d\u8981\u8f93\u51fa\u753b\u5e08\u8bcd\u3002\n- \u7528\u6237\u660e\u786e\u63d0\u51fa\u7684\u4e3b\u4f53\u3001\u7269\u79cd\u3001\u82b1\u5349\u3001\u9053\u5177\u3001\u52a8\u4f5c\u3001\u670d\u88c5\u3001\u8868\u60c5\u3001\u955c\u5934\u548c\u753b\u9762\u91cd\u70b9\u5fc5\u987b\u539f\u4e49\u4fdd\u7559\uff0c\u4e0d\u8981\u66ff\u6362\u6210\u76f8\u90bb\u6982\u5ff5\u6216\u66f4\u5e38\u89c1\u7684\u7d20\u6750\u3002\u4f8b\u5982 pear blossoms \u4e0d\u80fd\u6539\u6210 cherry blossoms\uff0cserious \u4e0d\u80fd\u6539\u6210 smirk\u3002\n- \u53ea\u9009\u62e9\u4e00\u4e2a\u4e3b\u8981\u52a8\u4f5c\u3001\u4e00\u4e2a\u4e3b\u8981\u8868\u60c5\u548c\u4e00\u7ec4\u76f8\u5bb9\u7684\u955c\u5934\u5173\u7cfb\u3002\u4e0d\u8981\u8ffd\u52a0\u4f1a\u4e89\u593a\u80a2\u4f53\u3001\u89c6\u7ebf\u6216\u60c5\u7eea\u7684\u6b21\u8981\u6307\u4ee4\u3002\u6301\u6709\u7269\u5fc5\u987b\u540c\u65f6\u4fdd\u7559\u201c\u7269\u4ef6\u5b58\u5728\u201d\u548c\u201c\u7269\u4ef6\u5173\u7cfb\u201d\u4e24\u4e2a\u951a\u70b9\uff1b\u4f8b\u5982\u7528\u6237\u8981\u6c42\u5251\u6307\u89c2\u4f17\u65f6\u4f7f\u7528 holding sword\u3001sword pointed at viewer\uff0c\u4e0d\u8981\u628a\u5251\u6539\u6210\u4e3e\u8d77\u3001\u80cc\u5728\u8eab\u540e\u3001\u53cc\u5251\u6216\u7eaf\u88c5\u9970\u3002\n- \u89c6\u7ebf\u4e0e\u955c\u5934\u5fc5\u987b\u63cf\u8ff0\u540c\u4e00\u4e2a\u77ac\u95f4\uff1alooking away \u4e0e looking at viewer\u3001profile \u4e0e frontal view\u3001eyes closed \u4e0e looking at viewer \u4e0d\u5f97\u540c\u65f6\u51fa\u73b0\u3002\u53ea\u4fdd\u7559\u6700\u7b26\u5408\u7528\u6237\u539f\u610f\u7684\u4e00\u9879\uff1b\u7528\u6237\u672a\u6307\u5b9a\u65f6\u9009\u62e9\u6700\u5bb9\u6613\u8868\u73b0\u4e3b\u9898\u7684\u4e00\u9879\u3002\n- \u5177\u4f53\u7269\u79cd\u3001\u82b1\u5349\u6216\u7279\u8272\u7269\u4ef6\u662f\u4e3b\u9898\u6838\u5fc3\u65f6\uff0c\u9664\u4fdd\u7559\u5176\u51c6\u786e\u540d\u79f0\u5916\uff0c\u518d\u4f7f\u7528 2-3 \u4e2a\u4e0d\u6539\u53d8\u7c7b\u522b\u7684\u53ef\u89c1\u5f62\u6001\u951a\u70b9\u3002\u4f8b\u5982\u68a8\u82b1\u53ef\u4f7f\u7528 pear blossoms\u3001white five-petaled flowers\u3001pear tree branches\uff1b\u8fd9\u4e9b\u951a\u70b9\u5fc5\u987b\u63cf\u8ff0\u540c\u4e00\u5bf9\u8c61\uff0c\u4e0d\u80fd\u6362\u6210\u6a31\u82b1\u6216\u989d\u5916\u589e\u52a0\u53e6\u4e00\u79cd\u82b1\u3002\n- \u62bd\u8c61\u4e3b\u9898\u53ef\u4ee5\u8f6c\u5316\u4e3a\u53ef\u89c1\u7b26\u53f7\uff0c\u4f46\u5fc5\u987b\u5148\u786e\u5b9a\u201c\u8c01\u5bf9\u4ec0\u4e48\u505a\u4e86\u4ec0\u4e48\u201d\u4ee5\u53ca\u52a8\u4f5c\u4ea7\u751f\u7684\u53ef\u89c1\u7ed3\u679c\uff0c\u518d\u4fdd\u7559\u81f3\u5c11\u4e24\u4e2a\u76f4\u63a5\u8868\u8fbe\u539f\u4e3b\u9898\u7684\u89c6\u89c9\u951a\u70b9\u3002\u4e0d\u8981\u628a\u201c\u521b\u9020\u5149\u201d\u6539\u5199\u6210\u201c\u4f38\u624b\u63a5\u53d7\u5149\u201d\uff0c\u4e5f\u4e0d\u8981\u8ba9\u81ea\u884c\u8865\u5145\u7684\u738b\u5ea7\u3001\u793c\u670d\u3001\u82b1\u6735\u7b49\u5e38\u89c1\u7d20\u6750\u53d6\u4ee3\u4e3b\u9898\u3002\n- \u5982\u679c\u7528\u6237\u8f93\u5165\u4e3b\u8981\u7531\u9017\u53f7\u5206\u9694\u7684 tags \u6784\u6210\uff0c\u53ea\u6574\u7406\u6709\u6548 tags\u3001\u7ffb\u8bd1\u5176\u4e2d\u5c11\u91cf\u4e2d\u6587\u8981\u6c42\u3001\u5220\u9664\u91cd\u590d\u548c\u51b2\u7a81\u9879\uff1b\u4e0d\u8981\u91cd\u65b0\u8bbe\u8ba1\u753b\u9762\uff0c\u4e5f\u4e0d\u8981\u4e3a\u4e86\u8fbe\u5230\u6570\u91cf\u76ee\u6807\u6269\u5199\u3002\n\n\u7ec6\u8282\u5bc6\u5ea6\uff1a\n- \u5148\u5728\u5185\u90e8\u628a\u753b\u9762\u4fe1\u606f\u5206\u914d\u5230\u4e0d\u540c\u69fd\u4f4d\uff1a\u4e3b\u9898\u4e0e\u5173\u952e\u5173\u7cfb\u3001\u52a8\u4f5c\u548c\u624b\u52bf\u3001\u795e\u6001\u4e0e\u89c6\u7ebf\u3001\u670d\u88c5\u7ed3\u6784\u3001\u6750\u8d28\u7eb9\u6837\u4e0e\u914d\u9970\u3001\u524d\u666f\u4e92\u52a8\u5143\u7d20\u3001\u7b80\u6d01\u80cc\u666f\u5c42\u6b21\u3001\u6784\u56fe\u955c\u5934\u3001\u5149\u5f71\u3001\u7279\u6548\u3002\u4e00\u4e2a\u69fd\u4f4d\u5df2\u7ecf\u8db3\u591f\u6e05\u695a\u540e\uff0c\u5e94\u8865\u5145\u7f3a\u5931\u69fd\u4f4d\uff0c\u4e0d\u8981\u7ee7\u7eed\u5806\u53e0\u8fd1\u4e49\u8bcd\u3002\n- \u670d\u9970\u901a\u5e38\u4f7f\u7528 10-16 \u4e2a\u6709\u6548 tags\uff0c\u590d\u6742\u793c\u670d\u6700\u591a\u7ea6 18 \u4e2a\uff1b\u4ece\u6b3e\u5f0f\u3001\u526a\u88c1\u3001\u5c42\u6b21\u3001\u9886\u53e3\u3001\u8896\u578b\u3001\u8170\u90e8\u3001\u4e0b\u88c5\u3001\u6750\u8d28\u3001\u914d\u8272\u3001\u7eb9\u6837\u3001\u9576\u8fb9\u3001\u6263\u4ef6\u3001\u9970\u54c1\u548c\u978b\u889c\u4e2d\u53ea\u9009\u62e9\u753b\u9762\u5b9e\u9645\u53ef\u89c1\u4e14\u5f7c\u6b64\u76f8\u5bb9\u7684\u7ec6\u8282\u3002\u7528\u6237\u672a\u63d0\u53ca\u978b\u889c\u4e14\u4e3b\u9898\u4e0d\u4f9d\u8d56\u8db3\u90e8\u9020\u578b\u65f6\uff0c\u4e0d\u8981\u81ea\u884c\u8865\u5145\u9774\u5b50\u3001\u9ad8\u8ddf\u978b\u3001\u889c\u5b50\u6216\u817f\u9970\u3002\n- \u52a8\u4f5c\u4e0e\u59ff\u6001\u901a\u5e38\u4f7f\u7528 4-8 \u4e2a tags\uff0c\u8986\u76d6\u6574\u4f53\u59ff\u52bf\u3001\u8eab\u4f53\u671d\u5411\u3001\u5173\u952e\u80a2\u4f53\u3001\u624b\u90e8\u52a8\u4f5c\u3001\u6301\u6709\u7269\u548c\u91cd\u5fc3\uff1b\u5148\u4fdd\u8bc1\u4e3b\u8981\u52a8\u4f5c\u5b8c\u6574\uff0c\u4e0d\u8981\u7528\u591a\u4e2a\u52a8\u4f5c\u51d1\u6570\u91cf\u3002\n- \u795e\u6001\u901a\u5e38\u4f7f\u7528 2-4 \u4e2a\u76f8\u5bb9 tags\uff0c\u8986\u76d6\u89c6\u7ebf\u3001\u773c\u90e8\u3001\u5634\u90e8\u548c\u6838\u5fc3\u60c5\u7eea\u3002\u7528\u6237\u660e\u786e\u795e\u6001\u65f6\uff0c\u4e0d\u8981\u8ffd\u52a0\u76f8\u53cd\u6216\u7a00\u91ca\u5b83\u7684\u8868\u60c5\u3002\n- \u80cc\u666f\u4e0e\u73af\u5883\u901a\u5e38\u4f7f\u7528 4-10 \u4e2a tags\uff0c\u5149\u5f71\u3001\u7279\u6548\u548c\u6c1b\u56f4\u901a\u5e38\u4f7f\u7528 3-6 \u4e2a tags\uff1b\u53ea\u4fdd\u7559\u771f\u6b63\u5e2e\u52a9\u4e3b\u9898\u7684\u5185\u5bb9\u3002\n- \u540c\u4e00\u8bed\u4e49\u7c07\u6700\u591a\u4fdd\u7559 1-2 \u4e2a\u8bcd\u3002\u5149\u6e90\u5f62\u6001\u3001\u5149\u675f\u3001\u8f6e\u5ed3\u5149\u3001\u6295\u5f71\u548c\u7a7a\u6c14\u7c92\u5b50\u5c5e\u4e8e\u4e0d\u540c\u529f\u80fd\uff0c\u53ef\u4ee5\u5206\u522b\u63cf\u8ff0\uff1bglowing\u3001illuminated\u3001bright\u3001luminous\u3001radiant \u7b49\u53ea\u662f\u5728\u91cd\u590d\u201c\u53d1\u5149\u201d\uff0c\u4e0d\u80fd\u540c\u65f6\u5806\u53e0\u3002\u5220\u9664\u540c\u4e49\u8bcd\u540e\uff0c\u5e94\u628a\u7a7a\u51fa\u7684\u7bc7\u5e45\u7528\u4e8e\u5177\u4f53\u670d\u88c5\u7ed3\u6784\u3001\u624b\u90e8\u4e0e\u7269\u4ef6\u5173\u7cfb\u3001\u6750\u8d28\u7eb9\u6837\u3001\u524d\u666f\u4e92\u52a8\u6216\u7a7a\u95f4\u5c42\u6b21\uff0c\u800c\u4e0d\u662f\u8ba9\u753b\u9762\u53d8\u5f97\u66f4\u5355\u8584\u3002\n- \u5e38\u89c4\u8f93\u51fa 40-55 \u4e2a\u4e92\u4e0d\u91cd\u590d\u3001\u53ef\u89c1\u3001\u53ef\u751f\u6210\u7684\u5185\u5bb9 tags\uff1b\u7b80\u5355\u8868\u60c5\u5305\u6216\u5934\u50cf\u53ef\u4ee5\u4f7f\u7528 30-45 \u4e2a\uff0c\u590d\u6742\u670d\u88c5\u6216\u590d\u6742\u6784\u56fe\u53ef\u589e\u52a0\u5230\u7ea6 60 \u4e2a\uff0c\u6700\u591a\u4e0d\u5f97\u8d85\u8fc7 65 \u4e2a\u3002\u5df2\u7ecf\u662f tags \u7684\u8f93\u5165\u4e0d\u8bbe\u6700\u4f4e\u6570\u91cf\u3002\u753b\u9762\u5143\u7d20\u5355\u8584\u65f6\u4f18\u5148\u589e\u52a0\u4eba\u7269\u3001\u670d\u88c5\u548c\u524d\u666f\u7684\u5177\u4f53\u7ec6\u8282\uff1b\u80cc\u666f\u4ecd\u4fdd\u6301\u7b80\u6d01\uff0c\u4e0d\u8981\u52a0\u5165\u7528\u6237\u672a\u8981\u6c42\u7684\u9053\u5177\u3001\u978b\u889c\u3001\u82b1\u6735\u3001\u5efa\u7b51\u6216\u8868\u60c5\u3002\n\n\u8868\u8fbe\u89c4\u5219\uff1a\n- \u4f18\u5148\u4f7f\u7528\u786e\u5b9e\u80fd\u8868\u8fbe\u53ef\u89c1\u753b\u9762\u5143\u7d20\u7684 Danbooru tags\u3002\u90e8\u5206\u6982\u5ff5\u76f4\u8bd1\u53ef\u80fd\u6ca1\u6709\u6709\u6548\u8bcd\u6761\uff0c\u5e94\u62c6\u89e3\u4e3a\u5177\u4f53\u5f62\u72b6\u3001\u6750\u8d28\u3001\u7eb9\u6837\u3001\u989c\u8272\u3001\u88c5\u9970\u548c\u89c6\u89c9\u611f\u53d7\u3002\u4f8b\u5982\u201c\u82d7\u65cf\u5c11\u5973\u201d\u53ef\u4ee5\u8f6c\u5316\u4e3a ornate silver headdress\u3001silver jewelry\u3001embroidered dress \u7b49\u53ef\u89c1\u5143\u7d20\u3002\n- \u4e0d\u8981\u7528 holding nothing\u3001no weapon\u3001without shoes \u7b49\u5426\u5b9a\u5f0f\u6216\u4e0d\u53ef\u89c1\u7684\u77ed\u8bed\u63cf\u8ff0\u7f3a\u5931\u5185\u5bb9\uff1b\u9700\u8981\u8868\u8fbe\u8d64\u8db3\u65f6\u4f7f\u7528 barefoot\uff0c\u5176\u4ed6\u672a\u51fa\u73b0\u7684\u7269\u4ef6\u76f4\u63a5\u7701\u7565\u3002\n- \u80cc\u666f\u4fdd\u6301\u7b80\u7ea6\u3001\u6709\u8bbe\u8ba1\u611f\u3002\u901a\u5e38\u53ea\u4f7f\u7528 2-6 \u4e2a\u80cc\u666f\u76f8\u5173 tags\uff0c\u53ef\u6839\u636e\u4e3b\u9898\u9009\u62e9 white background\u3001simple background\u3001character sheet\u3001subtle geometric background\u3001floating particles \u7b49\u5c11\u91cf\u5143\u7d20\uff0c\u4e0d\u8981\u540c\u65f6\u5806\u53e0\u591a\u4e2a\u5730\u70b9\u3001\u590d\u6742\u5efa\u7b51\u548c\u4e92\u76f8\u51b2\u7a81\u7684\u5149\u6e90\u3002\n- \u6ca1\u6709\u7279\u6b8a\u8981\u6c42\u65f6\uff0c\u6574\u4f53\u91c7\u7528\u53ef\u7231\u3001\u81ea\u7136\u3001\u7cbe\u81f4\u7684\u89d2\u8272\u8868\u73b0\u3002\u53ef\u7231\u4e3b\u8981\u4f53\u73b0\u5728\u670d\u88c5\u8bbe\u8ba1\u3001\u59ff\u6001\u548c\u795e\u6001\uff0c\u4e0d\u8981\u64c5\u81ea\u5e7c\u5316\u89d2\u8272\u3002\n- \u8f93\u51fa\u524d\u5148\u5220\u9664\u4e92\u76f8\u51b2\u7a81\u7684\u6784\u56fe\u3001\u5149\u5f71\u3001\u5929\u6c14\u548c\u753b\u98ce tags\uff0c\u5e76\u5408\u5e76 nude/naked\u3001mist/morning mist\u3001sheer fabric/translucent fabric \u7b49\u5305\u542b\u5173\u7cfb\u660e\u786e\u7684\u91cd\u590d\u8bcd\uff0c\u53ea\u4fdd\u7559\u66f4\u51c6\u786e\u7684\u4e00\u9879\u3002Tag \u6309\u4ee5\u4e0b\u4f18\u5148\u7ea7\u6392\u5217\uff1a\u7528\u6237\u660e\u786e\u8981\u6c42\u3001\u4e3b\u4f53\u52a8\u4f5c\u4e0e\u5173\u952e\u7269\u4ef6\u3001\u670d\u88c5\u3001\u795e\u6001\u3001\u6784\u56fe\u3001\u80cc\u666f\u3001\u5149\u5f71\u4e0e\u7279\u6548\u3001\u6c1b\u56f4\u4e0e\u753b\u98ce\u3002\u8d8a\u91cd\u8981\u7684\u5185\u5bb9\u8d8a\u9760\u524d\u3002\n\n\u89d2\u8272\u548c\u52a8\u6001\u4e0a\u4e0b\u6587\uff1a\n{character_rule}\n{search_block}\n{outfit_transfer_rule}\n{reference_rule}\n{img2img_rule}\n{sensual_rule}\n\n\u8fd9\u6b21\uff0c\u8bf7\u4e3a\u6211\u751f\u6210\u4ee5\u4e0b\u4e3b\u9898\u7684\u63d0\u793a\u8bcd\uff1a\n{theme}",
