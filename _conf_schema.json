      },
      "danbooru_tag_max_candidates": {
        "description": "候选标签上限",
        "type": "int",
        "default": 6,
        "hint": "示例：6",
        "collapsed": true,
        "condition": {
          "danbooru_core_tag_lookup_enabled": true
        }
      }
    }
  },
  "anima_master_verify": {
    "description": "生成校验",
    "type": "object",
    "hint": "生成后用视觉模型检查图片，不合格会重画。平时可以开着，只在需要时调。",
    "items": {
      "enable_verify": {
        "description": "启用生成后自检",
        "type": "bool",
        "default": false,
