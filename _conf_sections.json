{
  "sections": [
    {
      "key": "anima_master_basic",
      "description": "基础设置",
      "hint": "从这里开始。选择一套预设可以快速配置好画师、模型和参数。",
      "items": [
        "chiyo_preset",
        "reset_to_defaults"
      ]
    },
    {
      "key": "anima_master_comfyui_connection",
      "description": "ComfyUI 连接",
      "hint": "让插件连上你的 ComfyUI。",
      "items": [
        "comfyui_base_url",
        "workflow",
        "custom_workflow_enabled",
        "custom_workflow_path",
        "custom_workflow_override_parameters",
        "timeout",
        "poll_interval",
        "storage_retention_days",
        "manifest_max_records",
        "auto_start",
        "startup_command",
        "startup_workdir",
        "startup_visible_window",
        "auto_start_admin_only",
        "auto_start_allowed_sender_ids",
        "startup_wait_seconds",
        "startup_poll_interval"
      ]
    },
    {
      "key": "anima_master_models",
      "description": "模型文件",
      "hint": "填 ComfyUI 下拉框里显示的文件名，只填文件名，不填路径。",
      "items": [
        "unet_name",
        "clip_name",
        "vae_name"
      ]
    },
    {
      "key": "anima_master_rendering",
      "description": "出图参数",
      "hint": "每次出图的默认尺寸和采样设置。",
      "items": [
        "width",
        "height",
        "allowed_sizes",
        "steps",
        "cfg",
        "sampler_name",
        "scheduler"
      ]
    },
    {
      "key": "anima_master_default_prompt",
      "description": "默认提示词",
      "hint": "每次出图都会自动加到提示词里的正负面词。",
      "items": [
        "quality_prefix",
        "negative_prompt"
      ]
    },
    {
      "key": "anima_master_prompting",
      "description": "提示词生成",
      "hint": "把中文描述转成画图标签的相关设置。",
      "items": [
        "prompt_optimize_enabled",
        "prompt_builder_provider_id",
        "prompt_builder_max_tokens",
        "prompt_builder_max_content_tags",
        "prompt_builder_web_search_enabled",
        "prompt_builder_search_max_results",
        "prompt_builder_search_depth",
        "prompt_builder_search_query_template",
        "prompt_builder_deep_thinking_enabled",
        "prompt_builder_reasoning_effort",
        "low_cfg_harness_enabled",
        "prompt_builder_template"
      ]
    },
    {
      "key": "anima_master_style",
      "description": "角色与画风",
      "hint": "固定角色、画师预设和画风，以及涩气表现力相关设置。",
      "items": [
        "fixed_characters",
        "artist_presets",
        "active_artist_preset",
        "default_artist_tags",
        "style_tags",
        "style_presets",
        "active_style_preset",
        "sensual_mode_enabled",
        "sensual_mode_markers"
      ]
    },
    {
      "key": "anima_master_tag_lookup",
      "description": "角色检索",
      "hint": "用于校正现有作品角色的标签。只在需要时访问 Donmai / Danbooru。",
      "items": [
        "danbooru_core_tag_lookup_enabled",
        "danbooru_tag_base_urls",
        "danbooru_tag_user_agent",
        "danbooru_tag_lookup_timeout",
        "danbooru_tag_max_candidates"
      ]
    },
    {
      "key": "anima_master_verify",
      "description": "生成校验",
      "hint": "生成后用视觉模型检查图片，不合格会重画。",
      "items": [
        "enable_verify",
        "verify_provider_id",
        "verify_pass_score",
        "max_verify_retry"
      ]
    },
    {
      "key": "anima_master_multi_person",
      "description": "多人生成",
      "hint": "只影响 /anm 多人：候选采样、视觉检查和并发。",
      "items": [
        "multi_candidate_count",
        "multi_verify_enabled",
        "multi_verify_provider_id",
        "multi_verify_pass_score",
        "multi_send_degraded_candidate",
        "multi_show_degraded_notice",
        "multi_max_concurrent_generations"
      ]
    },
    {
      "key": "anima_master_delivery",
      "description": "发送与权限",
      "hint": "图片是否发回聊天，以及谁可以使用插件。",
      "items": [
        "send_result_to_chat",
        "max_send_images",
        "admin_only",
        "allowed_sender_ids"
      ]
    },
    {
      "key": "anima_master_experimental",
      "description": "可选功能",
      "hint": "图生图、放大、去背景等附加能力，不影响基础文生图。",
      "items": [
        "img2img_enabled",
        "prompt_optimize_img2img_enabled",
        "edit_denoise",
        "max_image_side",
        "upscale_factor",
        "remove_bg_model"
      ]
    },
    {
      "key": "anima_master_debug",
      "description": "调试",
      "hint": "只在排查问题时临时开启，平时保持关闭。",
      "items": [
        "debug_prompt_enabled",
        "debug_image_reference_enabled",
        "debug_send_payload_enabled"
      ]
    }
  ]
}
