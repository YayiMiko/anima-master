{
  "sections": [
    {
      "key": "anima_master_basic",
      "description": "预设与恢复",
      "hint": "用于恢复默认配置，或快速应用千代预设。",
      "items": [
        "reset_to_defaults",
        "chiyo_preset_enabled"
      ]
    },
    {
      "key": "anima_master_comfyui_connection",
      "description": "ComfyUI 连接",
      "hint": "用于连接 ComfyUI。通常请先用绘世启动器、ComfyUI portable 或自己的方式启动 ComfyUI；插件工作流类型不是 ComfyUI 本地保存的工作流名称。只有开启“由 AstrBot 启动 ComfyUI”后，启动命令才需要填写。",
      "items": [
        "comfyui_base_url",
        "workflow",
        "timeout",
        "poll_interval",
        "auto_start",
        "startup_command",
        "startup_workdir",
        "startup_visible_window",
        "auto_start_admin_only",
        "auto_start_allowed_sender_ids",
        "startup_wait_seconds",
        "startup_poll_interval"
      ]
    },
    {
      "key": "anima_master_models",
      "description": "模型文件",
      "hint": "首次配置时请对照 ComfyUI 下拉框确认；这里只填文件名，不填路径。如果状态检查显示模型不可用，优先检查这里。",
      "items": [
        "unet_name",
        "clip_name",
        "vae_name"
      ]
    },
    {
      "key": "anima_master_rendering",
      "description": "出图参数",
      "hint": "控制默认尺寸、采样步数、CFG、采样器和调度器。",
      "items": [
        "width",
        "height",
        "allowed_sizes",
        "steps",
        "cfg",
        "sampler_name",
        "scheduler"
      ]
    },
    {
      "key": "anima_master_default_prompt",
      "description": "默认提示词",
      "hint": "控制每次生图都会自动加入的正面质量词和负面提示词。",
      "items": [
        "quality_prefix",
        "negative_prompt"
      ]
    },
    {
      "key": "anima_master_prompting",
      "description": "自然语言优化",
      "hint": "控制中文描述转 Danbooru tags 的方式，以及是否启用联网搜索与深度思考。",
      "items": [
        "prompt_optimize_enabled",
        "prompt_builder_provider_id",
        "prompt_builder_max_tokens",
        "prompt_builder_max_content_tags",
        "prompt_builder_web_search_enabled",
        "prompt_builder_search_max_results",
        "prompt_builder_search_depth",
        "prompt_builder_search_query_template",
        "prompt_builder_deep_thinking_enabled",
        "prompt_builder_reasoning_effort",
        "prompt_builder_template"
      ]
    },
    {
      "key": "anima_master_tag_lookup",
      "description": "联网校正角色 Tag",
      "hint": "用于校正少量角色核心 tag；只在需要时访问 Donmai / Danbooru。",
      "items": [
        "danbooru_core_tag_lookup_enabled",
        "danbooru_tag_base_urls",
        "danbooru_tag_user_agent",
        "danbooru_tag_lookup_timeout",
        "danbooru_tag_max_candidates"
      ]
    },
    {
      "key": "anima_master_style",
      "description": "角色与风格",
      "hint": "用于角色、画师组和风格，以及涩气表现力相关设置。",
      "items": [
        "fixed_characters",
        "artist_presets",
        "active_artist_preset",
        "default_artist_tags",
        "sensual_mode_enabled",
        "sensual_mode_markers"
      ]
    },
    {
      "key": "anima_master_experimental",
      "description": "实验与附加功能",
      "hint": "包含图生图、放大和去背景等附加能力；不影响基础文生图。",
      "items": [
        "img2img_enabled",
        "prompt_optimize_img2img_enabled",
        "edit_denoise",
        "max_image_side",
        "upscale_factor",
        "remove_bg_model"
      ]
    },
    {
      "key": "anima_master_delivery",
      "description": "发送与权限",
      "hint": "控制图片是否发回聊天，以及哪些用户可以使用插件。",
      "items": [
        "send_result_to_chat",
        "max_send_images",
        "admin_only",
        "allowed_sender_ids"
      ]
    },
    {
      "key": "anima_master_debug",
      "description": "排查问题",
      "hint": "只在排查问题时临时开启，平时建议保持关闭。",
      "items": [
        "debug_prompt_enabled",
        "debug_image_reference_enabled",
        "debug_send_payload_enabled"
      ]
    }
  ]
}
