{
  // 这是 Anima 绘图大师的“带注释高级配置模板”。
  // 真正生效的运行文件是：
  // data/config/astrbot_plugin_anima_master_config.json
  // 运行文件是标准 JSON，不能直接写注释；如需手动深度自定义，请对照本模板修改。

  // 打开并保存后，下次插件加载时恢复 schema 默认值；执行一次后会自动回到 false。
  "reset_to_defaults": false,

  // 启用后，会把千代画师组写入 default_artist_tags，并把“狐莉”加入 fixed_characters。
  "chiyo_preset_enabled": false,

  // AstrBot 能访问到的 ComfyUI 地址。
  "comfyui_base_url": "http://127.0.0.1:8188",

  // 当前内置工作流名称。不了解时保持默认。
  "workflow": "anima_t2i",

  // 普通版默认关闭自定义工作流。Turbo 变体配置见 variants/turbo/。
  "custom_workflow_enabled": false,
  "custom_workflow_path": "",

  // 单次生成总超时（秒）。ComfyUI 排队久时可适当调大。
  "timeout": 300,

  // 轮询 ComfyUI 状态的间隔（秒）。
  "poll_interval": 2,

  // 默认出图尺寸。
  "width": 1024,
  "height": 1536,

  // 允许的尺寸列表。默认宽高不在列表中时，会自动贴近到最接近的允许尺寸。
  "allowed_sizes": [
    "832x1216",
    "896x1152",
    "1024x1024",
    "1152x896",
    "1216x832",
    "768x1344",
    "1344x768",
    "1024x1536"
  ],

  // 采样参数。
  "steps": 30,
  "cfg": 5.0,
  "sampler_name": "er_sde",
  "scheduler": "normal",

  // 使用自定义工作流时，默认保留工作流 JSON 内的采样参数。
  "custom_workflow_override_parameters": false,

  // 模型文件名。只填 ComfyUI 下拉框里显示的文件名，不填完整路径。
  "unet_name": "anima_baseV10.safetensors",
  "clip_name": "qwen_3_06b_base.safetensors",
  "vae_name": "qwen_image_vae.safetensors",

  // 固定拼接到正面提示词前后的默认词。
  "quality_prefix": "masterpiece, best quality, score_7, safe,",
  "negative_prompt": "worst quality, low quality, score_1, score_2, score_3, artist name",

  // 是否让聊天模型把中文需求整理成 Danbooru tags。
  "prompt_optimize_enabled": true,

  // 留空时使用当前聊天会话的主模型；填入后，专门用这个 Provider 来做提示词优化。
  "prompt_builder_provider_id": "",

  // 提示词优化模型的输出控制。
  "prompt_builder_max_tokens": 1000,

  // 联网搜索：只会在用户明确触发相关关键词时进入。
  "prompt_builder_web_search_enabled": true,
  "prompt_builder_search_max_results": 5,
  "prompt_builder_search_depth": "advanced",
  "prompt_builder_search_query_template": "{prompt} 角色 外观 立绘 服装 配色 武器 官方图 official art character design outfit appearance wiki fandom",

  // 深度思考：只会在用户明确触发相关关键词时进入；如果模型不支持，会自动降级。
  "prompt_builder_deep_thinking_enabled": true,
  "prompt_builder_reasoning_effort": "high",

  // 是否对疑似角色名做少量 Danbooru / Safebooru 核心 tag 校正。
  "danbooru_core_tag_lookup_enabled": true,
  "danbooru_tag_base_urls": "https://safebooru.donmai.us,https://danbooru.donmai.us",
  "danbooru_tag_user_agent": "AstrBotAnimaMaster/0.14",
  "danbooru_tag_lookup_timeout": 6.0,
  "danbooru_tag_max_candidates": 6,

  // 固定角色：格式为 “角色名=danbooru tags”。
  // 只有用户在聊天里明确提到角色名时才会使用。
  "fixed_characters": [],

  // 默认画师 / 画风 tags。用户说“不用我的风格 / 不要画师词”时会绕开。
  "default_artist_tags": "",

  // 画风 tags，会拼接在当前画师组之后。
  "style_tags": "",

  // 开启后，命中相关关键词时会让 LLM 自行写得更有边界表现力。
  "sensual_mode_enabled": true,
  "sensual_mode_markers": [
    "色气",
    "涩气",
    "擦边",
    "边界感",
    "性感",
    "诱惑",
    "魅惑",
    "妖艳",
    "撩人",
    "暧昧",
    "挑逗",
    "诱人",
    "透明",
    "透视",
    "黑纱",
    "薄纱",
    "蕾丝",
    "吊带",
    "紧身",
    "露肩",
    "绝对领域",
    "小恶魔",
    "suggestive",
    "seductive",
    "sexy",
    "sensual",
    "alluring",
    "see-through",
    "sheer",
    "transparent",
    "lace",
    "garter",
    "teasing"
  ],

  // 图生图仍属实验功能。当前更适合整图改图，不建议把它当稳定主线。
  "img2img_enabled": false,
  "prompt_optimize_img2img_enabled": false,
  "edit_denoise": 0.55,
  "max_image_side": 1024,

  // 这些项当前主线不常用，但仍可手调。
  "upscale_factor": 2.0,
  "remove_bg_model": "BiRefNet_lite",

  // 发送与权限。
  "send_result_to_chat": true,
  "max_send_images": 1,
  "admin_only": false,
  "allowed_sender_ids": [],

  // 由 AstrBot 启动 ComfyUI：不是开机自启，而是“收到绘图请求时，如果 ComfyUI 离线，再尝试启动”。
  // 仅对 AstrBot 所在机器生效。
  "auto_start": false,
  "startup_command": "",
  "startup_workdir": "",
  "startup_visible_window": true,
  "auto_start_admin_only": true,
  "auto_start_allowed_sender_ids": [],
  "startup_wait_seconds": 120,
  "startup_poll_interval": 3,

  // 主提示词模板。留空会使用插件内置模板。
  "prompt_builder_template": "我是一名 AI 画师，请根据以下主题设计大师级提示词。输出应为适用于 Anima 模型的英文 Danbooru tags，而不是自然语言描述。\n\n请先在内部拆解画面，再将结果汇总为一行、使用英文逗号分隔的 tags。不要输出分析过程、标题、Markdown、编号或中文。\n\n内容规则：\n- 为画面设计细致的服饰 tags、动作 tags、神态 tags，并根据主题补充必要的环境、背景、氛围、构图、镜头、光影和特效 tags。\n- 不要输出角色自身已有的固定设定，例如发色、瞳色、年龄、种族和固定配饰；固定角色词会由程序另行拼接。\n- 不要输出 masterpiece、best quality 等前置质量词，也不要输出画师词。\n- 用户明确提出的主题、动作、服装和画面重点必须优先保留，不要为了扩写而改变主题。\n\n细节密度：\n- 服饰是重点。完整服饰部分通常应包含至少 18 个有效 tags，并可根据服装复杂度继续增加；每一件画面中清晰可见的主要服装，应从款式、剪裁、层次、领口、袖型、腰部、下装、材质、配色、纹样、镶边、扣件、饰品、鞋袜和暴露方式中选取适用细节，每件尽量写出 5-10 个具体短 tag。\n- 动作与姿态在适用时通常至少写 8 个 tags，并可根据动作复杂度继续增加，覆盖整体姿势、身体朝向、四肢位置、手部动作、持有物、重心和运动趋势；不要只用 dynamic pose 之类的泛化词代替具体动作。\n- 神态在适用时通常至少写 4 个 tags，并可根据表达复杂度继续增加，覆盖视线、眼部状态、嘴部状态、情绪和头部角度；不同神态不要互相冲突。\n- 环境、背景、氛围、构图、镜头、光影和特效按主题需要补充，不设总量上限，但只选择真正帮助主题的内容。\n- 常规至少输出 55 个互不重复、可见、可生成的内容 tags，可按主题复杂度继续增加，不设数量上限。画面元素单薄时，应优先补充服装结构、动作细节、道具互动、轮廓光和少量设计元素，而不是堆叠同义词。\n\n表达规则：\n- 优先使用确实能表达可见画面元素的 Danbooru tags。部分概念直译可能没有有效词条，应拆解为具体形状、材质、纹样、颜色、装饰和视觉感受。例如“苗族少女”可以转化为 ornate silver headdress、silver jewelry、embroidered dress 等可见元素。\n- 背景保持简约、有设计感。通常只使用 2-6 个背景相关 tags，可根据主题选择 white background、simple background、character sheet、subtle geometric background、floating particles 等少量元素，不要同时堆叠多个地点、复杂建筑和互相冲突的光源。\n- 没有特殊要求时，整体采用可爱、自然、精致的角色表现。可爱主要体现在服装设计、姿态和神态，不要擅自幼化角色。\n\n角色和动态上下文：\n{character_rule}\n{search_block}\n{outfit_transfer_rule}\n{reference_rule}\n{img2img_rule}\n{sensual_rule}\n\n这次，请为我生成以下主题的提示词：\n{theme}",

  // 调试项默认关闭。只在排查问题时再开。
  "debug_prompt_enabled": false,
  "debug_image_reference_enabled": false,
  "debug_send_payload_enabled": false
}
