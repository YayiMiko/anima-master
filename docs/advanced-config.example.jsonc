{
  // 这是 Anima 绘图大师的“带注释高级配置模板”。
  // 真正生效的运行文件是：
  // data/config/astrbot_plugin_anima_master_config.json
  // 运行文件是标准 JSON，不能直接写注释；如需手动深度自定义，请对照本模板修改。

  // 打开并保存后，下次插件加载时恢复 schema 默认值；执行一次后会自动回到 false。
  "reset_to_defaults": false,

  // 千代预设：""（未启用）/ "base" / "aesthetic" / "turbo"。
  // 任一预设都会把对应的千代画师组写入 default_artist_tags，并把“狐莉”加入 fixed_characters。
  // aesthetic 另外覆盖 unet_name=anima_aestheticV11、cfg=3，且不注入质量词与负面词。
  // turbo 使用 Turbo LoRA 工作流、10 步、CFG 1、euler/simple 与低 CFG 提示词约束。
  "chiyo_preset": "",

  // AstrBot 能访问到的 ComfyUI 地址。
  "comfyui_base_url": "http://127.0.0.1:8188",

  // 当前内置工作流名称。不了解时保持默认。
  "workflow": "anima_t2i",

  // 普通版默认关闭自定义工作流。Turbo 变体配置见 variants/turbo/。
  "custom_workflow_enabled": false,
  "custom_workflow_path": "",

  // 单次生成总超时（秒）。ComfyUI 排队久时可适当调大。
  "timeout": 300,

  // 轮询 ComfyUI 状态的间隔（秒）。
  "poll_interval": 2,

  // 默认出图尺寸。
  "width": 1024,
  "height": 1536,

  // 允许的尺寸列表。默认宽高不在列表中时，会自动贴近到最接近的允许尺寸。
  "allowed_sizes": [
    "832x1216",
    "896x1152",
    "1024x1024",
    "1152x896",
    "1216x832",
    "768x1344",
    "1344x768",
    "1024x1536"
  ],

  // 采样参数。
  "steps": 30,
  "cfg": 5.0,
  "sampler_name": "er_sde",
  "scheduler": "normal",

  // 使用自定义工作流时，默认保留工作流 JSON 内的采样参数。
  "custom_workflow_override_parameters": false,

  // 模型文件名。只填 ComfyUI 下拉框里显示的文件名，不填完整路径。
  "unet_name": "anima_baseV10.safetensors",
  "clip_name": "qwen_3_06b_base.safetensors",
  "vae_name": "qwen_image_vae.safetensors",

  // 固定拼接到正面提示词前后的默认词。
  "quality_prefix": "masterpiece, best quality, score_7, safe,",
  "negative_prompt": "worst quality, low quality, score_1, score_2, score_3, artist name",

  // 是否让聊天模型把中文需求整理成 Danbooru tags。
  "prompt_optimize_enabled": true,

  // 留空时使用当前聊天会话的主模型；填入后，专门用这个 Provider 来做提示词优化。
  "prompt_builder_provider_id": "",

  // 提示词优化模型的输出控制。
  "prompt_builder_max_tokens": 1000,
  "prompt_builder_max_content_tags": 65,

  // 联网搜索：只会在用户明确触发相关关键词时进入。
  "prompt_builder_web_search_enabled": true,
  "prompt_builder_search_max_results": 5,
  "prompt_builder_search_depth": "advanced",
  "prompt_builder_search_query_template": "{prompt} 角色 外观 立绘 服装 配色 武器 官方图 official art character design outfit appearance wiki fandom",

  // 深度思考：只会在用户明确触发相关关键词时进入；如果模型不支持，会自动降级。
  "prompt_builder_deep_thinking_enabled": true,
  "prompt_builder_reasoning_effort": "high",

  // 是否对疑似角色名做少量 Danbooru / Safebooru 核心 tag 校正。
  "danbooru_core_tag_lookup_enabled": true,
  "danbooru_tag_base_urls": "https://safebooru.donmai.us,https://danbooru.donmai.us",
  "danbooru_tag_user_agent": "AstrBotAnimaMaster/0.14",
  "danbooru_tag_lookup_timeout": 6.0,
  "danbooru_tag_max_candidates": 6,

  // 固定角色：格式为 “角色名=danbooru tags”。
  // 只有用户在聊天里明确提到角色名时才会使用。
  "fixed_characters": [],

  // 默认画师 / 画风 tags。用户说“不用我的风格 / 不要画师词”时会绕开。
  "default_artist_tags": "",

  // 画风 tags，会拼接在当前画师组之后。
  "style_tags": "",

  // 开启后，命中相关关键词时会让 LLM 自行写得更有边界表现力。
  "sensual_mode_enabled": true,
  "sensual_mode_markers": [
    "色气",
    "涩气",
    "擦边",
    "边界感",
    "性感",
    "诱惑",
    "魅惑",
    "妖艳",
    "撩人",
    "暧昧",
    "挑逗",
    "诱人",
    "透明",
    "透视",
    "黑纱",
    "薄纱",
    "蕾丝",
    "吊带",
    "紧身",
    "露肩",
    "绝对领域",
    "小恶魔",
    "suggestive",
    "seductive",
    "sexy",
    "sensual",
    "alluring",
    "see-through",
    "sheer",
    "transparent",
    "lace",
    "garter",
    "teasing"
  ],

  // 图生图仍属实验功能。当前更适合整图改图，不建议把它当稳定主线。
  "img2img_enabled": false,
  "prompt_optimize_img2img_enabled": false,
  "edit_denoise": 0.55,
  "max_image_side": 1024,

  // 这些项当前主线不常用，但仍可手调。
  "upscale_factor": 2.0,
  "remove_bg_model": "BiRefNet_lite",

  // 发送与权限。
  "send_result_to_chat": true,
  "max_send_images": 1,
  "admin_only": false,
  "allowed_sender_ids": [],

  // 由 AstrBot 启动 ComfyUI：不是开机自启，而是“收到绘图请求时，如果 ComfyUI 离线，再尝试启动”。
  // 仅对 AstrBot 所在机器生效。
  "auto_start": false,
  "startup_command": "",
  "startup_workdir": "",
  "startup_visible_window": true,
  "auto_start_admin_only": true,
  "auto_start_allowed_sender_ids": [],
  "startup_wait_seconds": 120,
  "startup_poll_interval": 3,

  // 主提示词模板。留空会使用插件内置模板。
  "prompt_builder_template": "我是一名 AI 画师，请根据以下主题设计大师级提示词。输出应为适用于 Anima 模型的英文 Danbooru tags，而不是自然语言描述。\n\n请先在内部拆解画面，再将结果汇总为一行、使用英文逗号分隔的 tags。不要输出分析过程、标题、Markdown、编号或中文。\n\n内容规则：\n- 为画面设计细致的服饰 tags、动作 tags、神态 tags，并根据主题补充必要的环境、背景、氛围、构图、镜头、光影和特效 tags。\n- 不要输出角色自身已有的固定设定，例如发色、瞳色、年龄、种族和固定配饰；固定角色词会由程序另行拼接。\n- 不要输出 masterpiece、best quality 等前置质量词，也不要输出画师词。\n- 用户明确提出的主体、物种、花卉、道具、动作、服装、表情、镜头和画面重点必须原义保留，不要替换成相邻概念或更常见的素材。例如 pear blossoms 不能改成 cherry blossoms，serious 不能改成 smirk。\n- 只选择一个主要动作、一个主要表情和一组相容的镜头关系。不要追加会争夺肢体、视线或情绪的次要指令。持有物必须同时保留“物件存在”和“物件关系”两个锚点；例如用户要求剑指观众时使用 holding sword、sword pointed at viewer，不要把剑改成举起、背在身后、双剑或纯装饰。\n- 视线与镜头必须描述同一个瞬间：looking away 与 looking at viewer、profile 与 frontal view、eyes closed 与 looking at viewer 不得同时出现。只保留最符合用户原意的一项；用户未指定时选择最容易表现主题的一项。\n- 具体物种、花卉或特色物件是主题核心时，除保留其准确名称外，再使用 2-3 个不改变类别的可见形态锚点。例如梨花可使用 pear blossoms、white five-petaled flowers、pear tree branches；这些锚点必须描述同一对象，不能换成樱花或额外增加另一种花。\n- 抽象主题可以转化为可见符号，但必须保留至少两个直接表达原主题的视觉锚点，不要让自行补充的王座、礼服、花朵等常见素材取代主题。\n- 如果用户输入主要由逗号分隔的 tags 构成，只整理有效 tags、翻译其中少量中文要求、删除重复和冲突项；不要重新设计画面，也不要为了达到数量目标扩写。\n\n细节密度：\n- 服饰通常使用 10-16 个有效 tags，复杂礼服最多约 18 个；从款式、剪裁、层次、领口、袖型、腰部、下装、材质、配色、纹样、镶边、扣件、饰品和鞋袜中只选择画面实际可见且彼此相容的细节。用户未提及鞋袜且主题不依赖足部造型时，不要自行补充靴子、高跟鞋、袜子或腿饰。\n- 动作与姿态通常使用 4-8 个 tags，覆盖整体姿势、身体朝向、关键肢体、手部动作、持有物和重心；先保证主要动作完整，不要用多个动作凑数量。\n- 神态通常使用 2-4 个相容 tags，覆盖视线、眼部、嘴部和核心情绪。用户明确神态时，不要追加相反或稀释它的表情。\n- 背景与环境通常使用 4-10 个 tags，光影、特效和氛围通常使用 3-6 个 tags；只保留真正帮助主题的内容。\n- 常规输出 40-55 个互不重复、可见、可生成的内容 tags；复杂服装或复杂构图可增加到约 60 个，最多不得超过 65 个。已经是 tags 的输入不设最低数量。画面元素单薄时宁可保持简洁，也不要加入用户未要求的道具、鞋袜、花朵、建筑或表情。\n\n表达规则：\n- 优先使用确实能表达可见画面元素的 Danbooru tags。部分概念直译可能没有有效词条，应拆解为具体形状、材质、纹样、颜色、装饰和视觉感受。例如“苗族少女”可以转化为 ornate silver headdress、silver jewelry、embroidered dress 等可见元素。\n- 不要用 holding nothing、no weapon、without shoes 等否定式或不可见的短语描述缺失内容；需要表达赤足时使用 barefoot，其他未出现的物件直接省略。\n- 背景保持简约、有设计感。通常只使用 2-6 个背景相关 tags，可根据主题选择 white background、simple background、character sheet、subtle geometric background、floating particles 等少量元素，不要同时堆叠多个地点、复杂建筑和互相冲突的光源。\n- 没有特殊要求时，整体采用可爱、自然、精致的角色表现。可爱主要体现在服装设计、姿态和神态，不要擅自幼化角色。\n- 输出前先删除互相冲突的构图、光影、天气和画风 tags，并合并 nude/naked、mist/morning mist、sheer fabric/translucent fabric 等包含关系明确的重复词，只保留更准确的一项。Tag 按以下优先级排列：用户明确要求、主体动作与关键物件、服装、神态、构图、背景、光影与特效、氛围与画风。越重要的内容越靠前。\n\n角色和动态上下文：\n{character_rule}\n{search_block}\n{outfit_transfer_rule}\n{reference_rule}\n{img2img_rule}\n{sensual_rule}\n\n这次，请为我生成以下主题的提示词：\n{theme}",

  // 调试项默认关闭。只在排查问题时再开。
  "debug_prompt_enabled": false,
  "debug_image_reference_enabled": false,
  "debug_send_payload_enabled": false
}
